{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Pulse",
  "version": "2.0.0-preview.1",
  "identifier": "com.serverpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Server Pulse",
        "width": 440,
        "height": 620,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../assets/server-pulse.ico"],
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": false
  }
}
